{
  "$description": "Cragpack design tokens v1 (W3C Design Tokens format). Mirrors cragpack.css; change both together. Map to a Compose Multiplatform theme (ColorScheme, Typography, Shapes) in the KMP app.",
  "color": {
    "dark": {
      "bg":         { "$type": "color", "$value": "#1c1814", "$description": "Screen" },
      "ink":        { "$type": "color", "$value": "#f3ebe0", "$description": "Text" },
      "ink2":       { "$type": "color", "$value": "#dccfbb", "$description": "Secondary text" },
      "surface":    { "$type": "color", "$value": "#f3ebe017", "$description": "Card, row (9% ink)" },
      "surface2":   { "$type": "color", "$value": "#f3ebe02e", "$description": "Icon button, track (18% ink)" },
      "line":       { "$type": "color", "$value": "#f3ebe033", "$description": "Outline (20% ink)" },
      "raised":     { "$type": "color", "$value": "#2e2620", "$description": "Sheet, dialog, toast" },
      "solid":      { "$type": "color", "$value": "#f3ebe0", "$description": "Selected, dock" },
      "onSolid":    { "$type": "color", "$value": "#1c1814" },
      "accent":     { "$type": "color", "$value": "#f58a3c", "$description": "Action, tick, now, progress. Never a warning." },
      "onAccent":   { "$type": "color", "$value": "#1c1814" },
      "accentInk":  { "$type": "color", "$value": "#f58a3c", "$description": "Accent used as text" },
      "danger":     { "$type": "color", "$value": "#ff7a6b", "$description": "Destructive actions only" },
      "dangerInk":  { "$type": "color", "$value": "#ff8f82" },
      "onDanger":   { "$type": "color", "$value": "#1c1814" },
      "ring":       { "$type": "color", "$value": "#2a231c", "$description": "Avatar overlap ring" }
    },
    "light": {
      "bg":         { "$type": "color", "$value": "#f3ebe0" },
      "ink":        { "$type": "color", "$value": "#1c1814" },
      "ink2":       { "$type": "color", "$value": "#5c5145" },
      "surface":    { "$type": "color", "$value": "#1c18140f" },
      "surface2":   { "$type": "color", "$value": "#1c18141f" },
      "line":       { "$type": "color", "$value": "#1c18144d" },
      "raised":     { "$type": "color", "$value": "#fffaf3" },
      "solid":      { "$type": "color", "$value": "#1c1814" },
      "onSolid":    { "$type": "color", "$value": "#f3ebe0" },
      "accent":     { "$type": "color", "$value": "#f58a3c" },
      "onAccent":   { "$type": "color", "$value": "#1c1814" },
      "accentInk":  { "$type": "color", "$value": "#a8480f" },
      "danger":     { "$type": "color", "$value": "#b3261e" },
      "dangerInk":  { "$type": "color", "$value": "#b3261e" },
      "onDanger":   { "$type": "color", "$value": "#ffffff" },
      "ring":       { "$type": "color", "$value": "#f3ebe0" }
    },
    "photoScrim": { "$type": "color", "$value": "#1c1814e6", "$description": "Bottom of photo surfaces; photos stay dark in both themes" },
    "overlayScrim": { "$type": "color", "$value": "#0a08069e" }
  },
  "grade": {
    "$description": "Band = first digit of the grade as entered (Font 1–9A, French 1a–9c). V grades use their Font equivalent: VB→3, V0→4, V1–V2→5, V3–V5→6, V6–V10→7, V11–V16→8, V17→9. Text on every band is #1c1814 except 8 (#f3ebe0 with an ink outline).",
    "1": { "$type": "color", "$value": "#d9cdef", "$description": "1–2 soft lilac" },
    "2": { "$type": "color", "$value": "#d9cdef" },
    "3": { "$type": "color", "$value": "#f2b6c6", "$description": "3–4 soft pink" },
    "4": { "$type": "color", "$value": "#f2b6c6" },
    "5": { "$type": "color", "$value": "#a6d98c", "$description": "light green" },
    "6": { "$type": "color", "$value": "#6aa5e0", "$description": "blue" },
    "7": { "$type": "color", "$value": "#e2604f", "$description": "red" },
    "8": { "$type": "color", "$value": "#1c1814", "$description": "black" },
    "9": { "$type": "gradient", "$value": [
      { "color": "#f7dc7e", "position": 0 },
      { "color": "#d9a531", "position": 0.55 },
      { "color": "#b9841c", "position": 1 }
    ], "$description": "gold, 135°" }
  },
  "person": {
    "$description": "Given in join order",
    "1": { "$type": "color", "$value": "#c98f5a" },
    "2": { "$type": "color", "$value": "#7d9a6b" },
    "3": { "$type": "color", "$value": "#b5796a" },
    "4": { "$type": "color", "$value": "#8f96ad" },
    "5": { "$type": "color", "$value": "#cdb98a" }
  },
  "font": {
    "text":    { "$type": "fontFamily", "$value": ["Instrument Sans", "system-ui", "sans-serif"] },
    "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "Instrument Sans", "sans-serif"] },
    "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"] }
  },
  "type": {
    "titleXl": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "40px", "fontWeight": 700, "lineHeight": 1, "letterSpacing": "-0.02em" } },
    "h1":      { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "34px", "fontWeight": 700, "lineHeight": 1.1, "letterSpacing": "-0.02em" } },
    "h2":      { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "32px", "fontWeight": 700, "lineHeight": 1, "letterSpacing": "-0.02em" } },
    "h3":      { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "26px", "fontWeight": 700, "lineHeight": 1.1, "letterSpacing": "-0.01em" } },
    "big":     { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "24px", "fontWeight": 700, "lineHeight": 1.15 } },
    "title":   { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "20px", "fontWeight": 700, "lineHeight": 1 } },
    "rowName": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "17px", "fontWeight": 600, "lineHeight": 1.3 } },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "15px", "fontWeight": 500, "lineHeight": 1.3 } },
    "label":   { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "13px", "fontWeight": 600, "lineHeight": 1.3, "$description": "Smallest text allowed" } },
    "mono":    { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.3, "$description": "Links, codes, times (.mono in cragpack.css)" } }
  },
  "size": {
    "tap":     { "$type": "dimension", "$value": "52px", "$description": "Default tap target" },
    "tapSm":   { "$type": "dimension", "$value": "44px", "$description": "Minimum tap target" },
    "edge":    { "$type": "dimension", "$value": "16px", "$description": "Screen side margin" },
    "gap":     { "$type": "dimension", "$value": "8px" },
    "dock":    { "$type": "dimension", "$value": "64px" },
    "input":   { "$type": "dimension", "$value": "56px" },
    "row":     { "$type": "dimension", "$value": "76px" },
    "rowSlim": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "14px" },
    "md":   { "$type": "dimension", "$value": "24px" },
    "lg":   { "$type": "dimension", "$value": "32px" },
    "xl":   { "$type": "dimension", "$value": "36px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "icon": {
    "set":    { "$value": "Lucide 0.460.0 (ISC)", "$description": "Source: icons.svg. Stroke 2, round caps and joins, no fill (star fills when on)." },
    "size":   { "$type": "dimension", "$value": "24px" },
    "sizeSm": { "$type": "dimension", "$value": "18px" }
  }
}
